# =====================================================================
#  cc0 -- a compiler for the C subset, written in hex0 macro assembly.
#
#  reads a C source file on stdin, writes hex0 assembly on stdout.
#  Calling convention of the routines below: arguments in rdi,rsi,rdx,rcx
#  stored immediately into locals V1..V4; result in rax.
#
#  Types are encoded as a single integer:
#      0      char
#      1      int / long / void
#      t+2    pointer to t
#  so size(t) = 1 when t==0 else 8.
# =====================================================================
7F 45 4C 46 02 01 01 00 00 00 00 00 00 00 00 00
02 00 3E 00 01 00 00 00
$__start
40 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 40 00 38 00 01 00 40 00 00 00 00 00
01 00 00 00 07 00 00 00
00 00 00 00 00 00 00 00
00 00 40 00 00 00 00 00
00 00 40 00 00 00 00 00
~__end 00 00 00 00
00 00 00 08 00 00 00 00
00 10 00 00 00 00 00 00

# ---------------------------------------------------------------- start
:__start
48 C7 C6 00 00 80 00       # mov rsi,0x800000
:rd1
B8 00 00 00 00             # mov eax,0     (read)
BF 00 00 00 00             # mov edi,0
BA 00 00 10 00             # mov edx,0x100000
0F 05                      # syscall
48 85 C0                   # test rax,rax
0F 8E @rd2                 # jle rd2
48 01 C6                   # add rsi,rax
E9 @rd1
:rd2
C6 06 00                   # mov byte [rsi],0
IA A_SRC
GSA @g_src
IA A_OUT
GSA @g_out
IA 01 00 00 00
GSA @g_line
CALL @compile
GDA @g_out
D_A
48 C7 C6 00 00 00 02       # mov rsi,0x2000000
48 29 F2                   # sub rdx,rsi
B8 01 00 00 00             # mov eax,1     (write)
BF 01 00 00 00             # mov edi,1
0F 05
B8 3C 00 00 00             # mov eax,60    (exit)
31 FF
0F 05

# ---------------------------------------------------- void emit_ch(c)
:emit_ch
PROLOG
ARG1
GDC @g_out
LDA V1
STB_C
INC_A
GDA @g_out
INC_A
GSA @g_out
EPILOG

# ------------------------------------------------- void emit_s(char*)
:emit_s
PROLOG
ARG1
:es1
LDA V1
LDZB_A
TEST_A
JE @es2
LDA V1
LDZB_A
I_A
CALL @emit_ch
LDA V1
INC_A
STA V1
JMP @es1
:es2
EPILOG

# ------------------------------------------------------- int hexc(n)
:hexc
PROLOG
ARG1
LDA V1
CMPI8_A 0A
JGE @hc1
ADDI_A 30 00 00 00
EPILOG
:hc1
ADDI_A 37 00 00 00
EPILOG

# --------------------------------------------- void emit_hb(b)  "XX "
:emit_hb
PROLOG
ARG1
LDA V1
SHRI_A 04
ANDI_A 0F 00 00 00
I_A
CALL @hexc
I_A
CALL @emit_ch
LDA V1
ANDI_A 0F 00 00 00
I_A
CALL @hexc
I_A
CALL @emit_ch
II 20 00 00 00
CALL @emit_ch
EPILOG

# ------------------------------------------ void emit_nb(value,count)
:emit_nb
PROLOG
ARG1
ARG2
:enb1
LDA V2
TEST_A
JE @enb2
LDA V1
ANDI_A FF 00 00 00
I_A
CALL @emit_hb
LDA V1
SHRI_A 08
STA V1
LDA V2
DEC_A
STA V2
JMP @enb1
:enb2
EPILOG

# ------------------------------------------------- void emit_dec(n)
:emit_dec
PROLOG
ARG1
LDA V1
CMPI8_A 0A
JL @ed1
LDA V1
CQO
IC 0A 00 00 00
IDIV_C
I_A
CALL @emit_dec
:ed1
LDA V1
CQO
IC 0A 00 00 00
IDIV_C
A_D
ADDI_A 30 00 00 00
I_A
CALL @emit_ch
EPILOG

# -------------------------------------------------- void werr(char*)
:werr
PROLOG
ARG1
LDA V1
STA V2
:we1
LDA V2
LDZB_A
TEST_A
JE @we2
LDA V2
INC_A
STA V2
JMP @we1
:we2
LDA V2
LDC V1
SUB_AC
D_A
LDS V1
IA 01 00 00 00
II 02 00 00 00
SYSCALL
EPILOG

# ------------------------------------------------- void werrdec(n)
:werrdec
PROLOG
ARG1
LDA V1
CMPI8_A 0A
JL @wd1
LDA V1
CQO
IC 0A 00 00 00
IDIV_C
I_A
CALL @werrdec
:wd1
LDA V1
CQO
IC 0A 00 00 00
IDIV_C
A_D
ADDI_A 30 00 00 00
STA V2
LEAL_S V2
ID 01 00 00 00
IA 01 00 00 00
II 02 00 00 00
SYSCALL
EPILOG

# --------------------------------------------------- void die(char*)
:die
PROLOG
ARG1
LEA_A @s_cc0
I_A
CALL @werr
LDA V1
I_A
CALL @werr
LEA_A @s_ln
I_A
CALL @werr
GDA @g_line
I_A
CALL @werrdec
LEA_A @s_nl
I_A
CALL @werr
IA 3C 00 00 00
II 01 00 00 00
SYSCALL
EPILOG

# --------------------------------- int meq(char *a, char *b, long n)
:meq
PROLOG
ARG1
ARG2
ARG3
IA 00 00 00 00
STA V4
:mq1
LDA V4
LDC V3
CMP_AC
JGE @mq3
LDA V1
LDC V4
ADD_AC
LDZB_A
STA V5
LDA V2
LDC V4
ADD_AC
LDZB_A
LDC V5
CMP_AC
JNE @mq2
LDA V4
INC_A
STA V4
JMP @mq1
:mq2
IA 00 00 00 00
EPILOG
:mq3
IA 01 00 00 00
EPILOG

# ------------------------------- int tokeq(char *s)  token == s ?
:tokeq
PROLOG
ARG1
GDA @g_tk
CMPI8_A 01
JE @tq1
IA 00 00 00 00
EPILOG
:tq1
LDA V1
STA V2
:tq2
