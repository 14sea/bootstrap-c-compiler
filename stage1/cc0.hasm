:tq3
LDA V2
LDC V1
SUB_AC
GDC @g_tl
CMP_AC
JE @tq4
IA 00 00 00 00
EPILOG
:tq4
GDI @g_tp
LDS V1
GDD @g_tl
CALL @meq
EPILOG

# ===================================================== lexer =========
# void adv1()   src = src + 1
:adv1
PROLOG
GDA @g_src
INC_A
GSA @g_src
EPILOG

:isal
PROLOG
ARG1
LDA V1
CMPI8_A 61
JL @ia1
LDA V1
CMPI8_A 7A
JG @ia1
IA 01 00 00 00
EPILOG
:ia1
LDA V1
CMPI8_A 41
JL @ia2
LDA V1
CMPI8_A 5A
JG @ia2
IA 01 00 00 00
EPILOG
:ia2
LDA V1
CMPI8_A 5F
JNE @ia3
IA 01 00 00 00
EPILOG
:ia3
IA 00 00 00 00
EPILOG

:isdg
PROLOG
ARG1
LDA V1
CMPI8_A 30
JL @idg1
LDA V1
CMPI8_A 39
JG @idg1
IA 01 00 00 00
EPILOG
:idg1
IA 00 00 00 00
EPILOG

:isan
PROLOG
ARG1
LDI V1
CALL @isal
TEST_A
JNE @ian1
LDI V1
CALL @isdg
EPILOG
:ian1
IA 01 00 00 00
EPILOG

:hexv
PROLOG
ARG1
LDA V1
CMPI8_A 30
JL @hx9
LDA V1
CMPI8_A 39
JG @hx1
LDA V1
SUBI8_A 30
EPILOG
:hx1
LDA V1
CMPI8_A 41
JL @hx9
LDA V1
CMPI8_A 46
JG @hx2
LDA V1
SUBI8_A 37
EPILOG
:hx2
LDA V1
CMPI8_A 61
JL @hx9
LDA V1
CMPI8_A 66
JG @hx9
LDA V1
SUBI8_A 57
EPILOG
:hx9
IMA FF FF FF FF
EPILOG

